{
  "name": "fs-linker",
  "version": "0.1.0",
  "description": "File system linker via native operating system symlinks",
  "keywords": [
    "cli",
    "filesystem",
    "linker",
    "symlink"
  ],
  "homepage": "https://github.com/hireddev/fs-linker#readme",
  "bugs": {
    "url": "https://github.com/hireddev/fs-linker/issues"
  },
  "license": "MIT",
  "author": "Ali Karpykov <alikarpykov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hireddev/fs-linker"
  },
  "bin": {
    "fsl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "pastel dev",
    "start": "pastel start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "ink": "^7.1.0",
    "pastel": "^4.0.1",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
